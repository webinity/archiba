<!DOCTYPE html>
<html lang="cs">
    <head>
        <script async
            src="https://www.googletagmanager.com/gtag/js?id=G-JESWZ2CWW1"></script>
        <script>
            window.dataLayer = window.dataLayer || []; function
            gtag(){dataLayer.push(arguments);} gtag('js', new Date());

            gtag('config', 'G-JESWZ2CWW1');
        </script>
        {% if ENVIRONMENT != 'DEV' %}
        <meta http-equiv="Content-Security-Policy"
            content="upgrade-insecure-requests" />
        {% endif %}
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <meta name="description" content="{% block meta_description %}Ing. arch. Barbora Bursová - architektonický ateliér v Turnově. Návrhy interiérů, rodinných domů, rekonstrukce a urbanistické studie.{% endblock %}" />
        <meta name="author" content="Barbora Bursová" />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href="https://archiba.cz{{ app.request.uri.path ?? '' }}" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://archiba.cz{{ app.request.uri.path ?? '' }}" />
        <meta property="og:title" content="{% block og_title %}Ing. arch. Barbora Bursová | architektura a design{% endblock %}" />
        <meta property="og:description" content="{% block og_description %}Architektonický ateliér v Turnově - návrhy interiérů, rodinných domů, rekonstrukce a urbanistické studie.{% endblock %}" />
        <meta property="og:image" content="https://archiba.cz/assets/imgs/og-image.jpg" />
        <meta property="og:locale" content="cs_CZ" />
        <meta property="og:site_name" content="Archiba - Ing. arch. Barbora Bursová" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="{% block twitter_title %}Ing. arch. Barbora Bursová | architektura a design{% endblock %}" />
        <meta name="twitter:description" content="{% block twitter_description %}Architektonický ateliér v Turnově - návrhy interiérů, rodinných domů a rekonstrukce.{% endblock %}" />
        <meta name="twitter:image" content="https://archiba.cz/assets/imgs/og-image.jpg" />

        {# Structured Data - LocalBusiness #}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "LocalBusiness",
            "name": "Archiba - Ing. arch. Barbora Bursová",
            "description": "Architektonický ateliér specializující se na návrhy interiérů, rodinných domů, rekonstrukce a urbanistické studie.",
            "url": "https://archiba.cz",
            "telephone": "+420777777523",
            "email": "barbora@archiba.cz",
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "Ohrazenice 168",
                "addressLocality": "Turnov",
                "postalCode": "511 01",
                "addressCountry": "CZ"
            },
            "founder": {
                "@type": "Person",
                "name": "Ing. arch. Barbora Bursová",
                "jobTitle": "Architekt"
            },
            "openingHours": "Mo-Fr 09:00-17:00",
            "sameAs": [
                "https://www.instagram.com/_archiba/"
            ]
        }
        </script>

        <link rel="shortcut icon"
            href="{{ asset('imgs/favicon.ico') }}"
            type="image/x-icon" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
            rel="stylesheet" />
        <link href="http://fonts.cdnfonts.com/css/bahnschrift"
            rel="stylesheet" />
        {% if ENVIRONMENT != 'DEV' %}
        <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
        {% endif %}

        <title>{% block title %}Ing. arch. Barbora Bursová | architektura a design{% endblock %}</title>
        {% block head %}{% endblock %}
    </head>

    <body>
        <div id="app">
            <nav>
                <div>
                    <a class="logo" href="/">
                        <img src="{{ asset('imgs/logo.png') }}"
                            alt="Logo Archiba" />
                    </a>
                    <div class="hamburger">
                        {% include 'partials/hamburger.twig' %}
                    </div>
                    <div class="nav-list" id="nav-open">
                        <div class="close">
                            {% include 'partials/close.twig' %}
                        </div>
                        <ul>
                            <li><a href="/projekty">projekty</a></li>
                            <li><a href="/sluzby">služby</a></li>
                            <li class="close-nav">
                                <a href="#kontakt">kontakt</a>
                            </li>
                            <li><a href="/bio">bio</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <main>
                {% block content %}

                {% endblock %}
            </main>

            <footer id="kontakt">
                <div class="container">
                    <ul class="name">
                        <li>Ing. arch. Barbora Bursová</li>
                        <li>
                            <a href="tel:+420777777523">+ 420 777 777 523</a>
                        </li>
                        <li>
                            <a href="mailto:barbora@archiba.cz">
                                barbora@archiba.cz
                            </a>
                        </li>
                        <li>Kancelář:</li>
                        <li>Ohrazenice 168</li>
                        <li>Turnov 511 01</li>
                    </ul>

                    <div class="insta">
                        <a target="_blank"
                            rel="noopener noreferrer"
                            href="https://www.instagram.com/_archiba/">
                            {% include 'svg/instagram.twig' %}
                        </a>
                    </div>

                    <address>
                        <ul>
                            <li>IČ: 07943474</li>
                            <li>Sedmihorky 19</li>
                            <li>511 01 Turnov</li>
                            <li>Česká republika</li>
                        </ul>
                    </address>
                </div>
            </footer>
        </div>
        {% if ENVIRONMENT == 'DEV' %}
        <!-- Vite dev server -->
        <script type="module" src="http://localhost:5174/@vite/client"></script>
        <script type="module" src="http://localhost:5174/js/app.js"></script>
        {% else %}
        <script type="text/javascript" src="{{ asset('js/app.js') }}"></script>
        {% endif %}
        {% block script %}

        {% endblock %}
    </body>
</html>
