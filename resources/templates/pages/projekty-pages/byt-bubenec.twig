{% extends 'index.twig' %}

{% block title %}Byt v Bubenči | Ing. arch. Barbora Bursová{% endblock %}
{% block meta_description %}Kompletní rekonstrukce bytu na Vítězném náměstí v duchu třicátých let. Realizace 2022-2025.{% endblock %}
{% block og_title %}Byt v Bubenči - Kompletní rekonstrukce | Ing. arch. Barbora Bursová{% endblock %}
